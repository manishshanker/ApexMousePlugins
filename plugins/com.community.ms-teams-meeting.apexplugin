{
  "schemaVersion": "1.0",
  "id": "com.community.ms-teams-meeting",
  "name": "Microsoft Teams Meeting Deck",
  "author": {
    "name": "CollabDesk",
    "url": "https://apexmouse.tech/community"
  },
  "version": "1.0.0",
  "targetBundleId": "com.microsoft.teams2",
  "targetAppName": "Microsoft Teams",
  "category": "productivity",
  "description": "Instant meeting controls: 1-click Mic Mute, Camera toggle, Raise Hand, Screen Share, and Chat navigator.",
  "icon": "person.3.sequence.fill",
  "contents": {
    "radialMenu": [
      {
        "label": "Mute / Unmute",
        "systemImage": "mic.slash.fill",
        "shortcut": "⇧⌘M"
      },
      {
        "label": "Camera On/Off",
        "systemImage": "video.fill",
        "shortcut": "⇧⌘O"
      },
      {
        "label": "Raise Hand",
        "systemImage": "hand.raised.fill",
        "shortcut": "⇧⌘K"
      },
      {
        "label": "Share Screen",
        "systemImage": "rectangle.on.rectangle",
        "shortcut": "⇧⌘E"
      },
      {
        "label": "Search Chats",
        "systemImage": "magnifyingglass",
        "shortcut": "⌘E"
      },
      {
        "label": "Filter Unread",
        "systemImage": "line.3.horizontal.decrease.circle",
        "shortcut": "⇧⌘U"
      },
      {
        "label": "Next Chat",
        "systemImage": "bubble.left.and.bubble.right.fill",
        "shortcut": "⌥Down Arrow"
      },
      {
        "label": "Previous Chat",
        "systemImage": "bubble.left",
        "shortcut": "⌥Up Arrow"
      }
    ],
    "buttonMappings": {
      "button3_click": {
        "shortcut": "⇧⌘M"
      },
      "button4_click": {
        "shortcut": "⇧⌘K"
      }
    }
  }
}
