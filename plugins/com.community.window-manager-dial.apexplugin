{
  "schemaVersion": "1.0",
  "id": "com.community.window-manager-dial",
  "name": "Window Snapping & Space Dial",
  "author": {
    "name": "WindowForge",
    "url": "https://apexmouse.tech/community"
  },
  "version": "1.0.0",
  "targetBundleId": "*",
  "targetAppName": "Global (All Apps)",
  "category": "productivity",
  "description": "8-way directional radial dial to snap active windows to halves, corners, maximize, or throw between displays.",
  "icon": "rectangle.split.2x1.fill",
  "contents": {
    "radialMenu": [
      {
        "label": "Snap Left",
        "systemImage": "rectangle.righthalf.inset.filled",
        "systemAction": "snapLeft"
      },
      {
        "label": "Snap Right",
        "systemImage": "rectangle.leadinghalf.inset.filled",
        "systemAction": "snapRight"
      },
      {
        "label": "Maximize",
        "systemImage": "arrow.up.left.and.arrow.down.right",
        "systemAction": "snapMaximize"
      },
      {
        "label": "Center",
        "systemImage": "square.inset.filled",
        "systemAction": "snapCenter"
      },
      {
        "label": "Snap Top",
        "systemImage": "rectangle.tophalf.inset.filled",
        "systemAction": "snapTop"
      },
      {
        "label": "Snap Bottom",
        "systemImage": "rectangle.bottomhalf.inset.filled",
        "systemAction": "snapBottom"
      },
      {
        "label": "Next Display",
        "systemImage": "display.2",
        "systemAction": "snapNextDisplay"
      },
      {
        "label": "Restore Size",
        "systemImage": "arrow.counterclockwise",
        "systemAction": "snapRestore"
      }
    ],
    "buttonMappings": {
      "button4_click": {
        "systemAction": "showWindowRadialDial"
      }
    }
  }
}
