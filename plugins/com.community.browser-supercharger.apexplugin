{
  "schemaVersion": "1.0",
  "id": "com.community.browser-supercharger",
  "name": "Universal Browser Power Deck",
  "author": {
    "name": "WebFlows",
    "url": "https://apexmouse.tech/community"
  },
  "version": "1.0.0",
  "targetBundleId": "*",
  "targetAppName": "Global (All Apps)",
  "category": "productivity",
  "description": "Universal navigation dial, instant tab switcher, reader mode, and history search across Safari, Chrome, Arc, and Brave.",
  "icon": "safari.fill",
  "contents": {
    "radialMenu": [
      {
        "label": "Back",
        "systemImage": "chevron.left",
        "shortcut": "⌘["
      },
      {
        "label": "Forward",
        "systemImage": "chevron.right",
        "shortcut": "⌘]"
      },
      {
        "label": "New Tab",
        "systemImage": "plus",
        "shortcut": "⌘T"
      },
      {
        "label": "Close Tab",
        "systemImage": "xmark",
        "shortcut": "⌘W"
      },
      {
        "label": "Reopen Tab",
        "systemImage": "arrow.counterclockwise",
        "shortcut": "⇧⌘T"
      },
      {
        "label": "Find in Page",
        "systemImage": "magnifyingglass",
        "shortcut": "⌘F"
      },
      {
        "label": "Reader Mode",
        "systemImage": "doc.plaintext",
        "shortcut": "⇧⌘R"
      },
      {
        "label": "Bookmark",
        "systemImage": "star.fill",
        "shortcut": "⌘D"
      }
    ],
    "buttonMappings": {
      "button3_click": {
        "systemAction": "cyclePreviousTab"
      },
      "button4_click": {
        "systemAction": "cycleNextTab"
      }
    }
  },
  "emoji": "🧭"
}
