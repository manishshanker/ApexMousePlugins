{
  "schemaVersion": "1.0",
  "id": "com.community.blender-orbit",
  "name": "Blender 4.x Viewport Orbit",
  "author": {
    "name": "PolyModeler",
    "url": "https://apexmouse.tech/community"
  },
  "version": "1.0.0",
  "targetBundleId": "org.blenderfoundation.blender",
  "targetAppName": "Blender",
  "category": "design",
  "description": "Shading modes, front/top/side orthographic cameras, and wireframe toggle.",
  "icon": "cube.fill",
  "contents": {
    "radialMenu": [
      {
        "label": "Front View",
        "systemImage": "square",
        "shortcut": "Numpad 1"
      },
      {
        "label": "Right View",
        "systemImage": "rectangle.righthalf.filled",
        "shortcut": "Numpad 3"
      },
      {
        "label": "Top View",
        "systemImage": "rectangle.tophalf.filled",
        "shortcut": "Numpad 7"
      },
      {
        "label": "Camera View",
        "systemImage": "camera.fill",
        "shortcut": "Numpad 0"
      },
      {
        "label": "Wireframe",
        "systemImage": "grid",
        "shortcut": "Z"
      },
      {
        "label": "Rendered View",
        "systemImage": "sparkles",
        "shortcut": "⇧Z"
      },
      {
        "label": "Focus Active",
        "systemImage": "scope",
        "shortcut": "Numpad ."
      },
      {
        "label": "Search Tools",
        "systemImage": "magnifyingglass",
        "shortcut": "F3"
      }
    ]
  },
  "emoji": "🧊"
}
