{
  "schemaVersion": "1.0",
  "id": "com.community.figma-pro",
  "name": "Figma SuperDial & Canvas",
  "author": {
    "name": "DesignCraft",
    "url": "https://apexmouse.tech/community"
  },
  "version": "1.0.0",
  "targetBundleId": "com.figma.Desktop",
  "targetAppName": "Figma",
  "category": "design",
  "description": "8-way auto-layout, component creation, frame selection, and zoom dials.",
  "icon": "paintbrush.fill",
  "contents": {
    "radialMenu": [
      {
        "label": "Auto Layout",
        "systemImage": "rectangle.split.2x1",
        "shortcut": "⇧A"
      },
      {
        "label": "Frame",
        "systemImage": "square.dashed",
        "shortcut": "⌥⌘G"
      },
      {
        "label": "Group",
        "systemImage": "folder",
        "shortcut": "⌘G"
      },
      {
        "label": "Component",
        "systemImage": "diamond",
        "shortcut": "⌥⌘K"
      },
      {
        "label": "Zoom to Fit",
        "systemImage": "arrow.up.left.and.arrow.down.right",
        "shortcut": "⇧1"
      },
      {
        "label": "Zoom 100%",
        "systemImage": "1.circle",
        "shortcut": "⇧0"
      },
      {
        "label": "Flatten",
        "systemImage": "arrow.triangle.merge",
        "shortcut": "⌘E"
      },
      {
        "label": "Hand Tool",
        "systemImage": "hand.raised.fill",
        "shortcut": "H"
      }
    ],
    "buttonMappings": {
      "button3_click": {
        "shortcut": "⌘Z"
      },
      "button4_click": {
        "shortcut": "⇧⌘Z"
      }
    },
    "scrollOverrides": {
      "speed": 1.15,
      "smoothScrollEnabled": true
    }
  },
  "emoji": "🎨"
}
