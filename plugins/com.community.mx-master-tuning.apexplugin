{
  "schemaVersion": "1.0",
  "id": "com.community.mx-master-tuning",
  "name": "Logitech MX Master 3S Tuning",
  "author": {
    "name": "ErgoDesk",
    "url": "https://apexmouse.tech/community"
  },
  "version": "1.0.0",
  "targetBundleId": "*",
  "targetAppName": "Global (All Apps)",
  "category": "hardware",
  "description": "120Hz smooth inertia coasting, thumb tab cycler, gesture stash, and 1-click Mission Control across all Mac apps.",
  "icon": "computermouse.fill",
  "contents": {
    "radialMenu": [
      {
        "label": "Mission Control",
        "systemImage": "square.2.layers.3d.top.filled",
        "systemAction": "missionControl"
      },
      {
        "label": "Show Desktop",
        "systemImage": "menubar.dock.rectangle",
        "systemAction": "showDesktop"
      },
      {
        "label": "New Window",
        "systemImage": "plus.rectangle.on.rectangle",
        "shortcut": "⌘N"
      },
      {
        "label": "Close Window",
        "systemImage": "xmark.circle",
        "shortcut": "⌘W"
      },
      {
        "label": "Drop Shelf",
        "systemImage": "tray.and.arrow.down.fill",
        "systemAction": "toggleDropShelf"
      },
      {
        "label": "Undo",
        "systemImage": "arrow.uturn.backward",
        "systemAction": "undo"
      },
      {
        "label": "Redo",
        "systemImage": "arrow.uturn.forward",
        "systemAction": "redo"
      },
      {
        "label": "App Switcher",
        "systemImage": "arrow.left.arrow.right",
        "systemAction": "appSwitcher"
      }
    ],
    "buttonMappings": {
      "button3_click": {
        "systemAction": "cyclePreviousTab"
      },
      "button4_click": {
        "systemAction": "cycleNextTab"
      }
    },
    "scrollOverrides": {
      "speed": 1.25,
      "duration": 0.22,
      "smoothScrollEnabled": true
    }
  },
  "emoji": "🖱️"
}
