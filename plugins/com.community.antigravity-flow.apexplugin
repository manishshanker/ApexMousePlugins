{
  "schemaVersion": "1.0",
  "id": "com.community.antigravity-flow",
  "name": "Antigravity Flow CLI",
  "author": {
    "name": "AgyTeam",
    "url": "https://apexmouse.tech/plugins"
  },
  "version": "1.0.0",
  "targetBundleId": "com.google.antigravity",
  "targetAppName": "Antigravity",
  "category": "coding",
  "description": "AI pair programming speed-dial: Terminal toggle, Agent Focus/Prompt, Command Palette, Code Format, File Tree, Git Diff, and Task Run.",
  "icon": "sparkles.rectangle.stack",
  "contents": {
    "radialMenu": [
      {
        "label": "Command Palette",
        "systemImage": "command",
        "shortcut": "⇧⌘P"
      },
      {
        "label": "Agent Prompt",
        "systemImage": "sparkles",
        "shortcut": "⌘K"
      },
      {
        "label": "Terminal",
        "systemImage": "terminal.fill",
        "shortcut": "⌃`"
      },
      {
        "label": "Format Code",
        "systemImage": "text.alignleft",
        "shortcut": "⇧⌥F"
      },
      {
        "label": "Git Changes",
        "systemImage": "arrow.triangle.branch",
        "shortcut": "⌃⇧G"
      },
      {
        "label": "File Explorer",
        "systemImage": "sidebar.left",
        "shortcut": "⌘B"
      },
      {
        "label": "Run Task",
        "systemImage": "play.fill",
        "shortcut": "⇧⌘B"
      },
      {
        "label": "Quick Open",
        "systemImage": "magnifyingglass",
        "shortcut": "⌘P"
      }
    ],
    "buttonMappings": {
      "button3_click": {
        "shortcut": "⌘Z"
      },
      "button4_click": {
        "shortcut": "⇧⌘Z"
      }
    },
    "scrollOverrides": {
      "speed": 1.15,
      "duration": 0.18,
      "smoothScrollEnabled": true
    }
  },
  "emoji": "⚡"
}
