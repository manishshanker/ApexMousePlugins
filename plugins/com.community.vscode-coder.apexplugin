{
  "schemaVersion": "1.0",
  "id": "com.community.vscode-coder",
  "name": "VS Code & Cursor Velocity",
  "author": {
    "name": "DevTools",
    "url": "https://apexmouse.tech/community"
  },
  "version": "1.0.0",
  "targetBundleId": "com.microsoft.VSCode",
  "targetAppName": "Visual Studio Code",
  "category": "coding",
  "description": "Terminal toggle, format document, command palette, and line commenting.",
  "icon": "curlybraces",
  "contents": {
    "radialMenu": [
      {
        "label": "Command Palette",
        "systemImage": "command",
        "shortcut": "⇧⌘P"
      },
      {
        "label": "Quick Open",
        "systemImage": "magnifyingglass",
        "shortcut": "⌘P"
      },
      {
        "label": "Terminal",
        "systemImage": "terminal.fill",
        "shortcut": "⌃`"
      },
      {
        "label": "Format Code",
        "systemImage": "text.alignleft",
        "shortcut": "⇧⌥F"
      },
      {
        "label": "Comment Line",
        "systemImage": "text.quote",
        "shortcut": "⌘/"
      },
      {
        "label": "Sidebar",
        "systemImage": "sidebar.left",
        "shortcut": "⌘B"
      },
      {
        "label": "Git Changes",
        "systemImage": "arrow.triangle.branch",
        "shortcut": "⌃⇧G"
      },
      {
        "label": "Multi-Cursor",
        "systemImage": "cursorarrow.motionlines",
        "shortcut": "⌥⌘Up Arrow"
      }
    ],
    "buttonMappings": {
      "button3_click": {
        "shortcut": "⌘["
      },
      "button4_click": {
        "shortcut": "⌘]"
      }
    }
  },
  "emoji": "💻"
}
