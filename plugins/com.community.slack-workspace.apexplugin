{
  "schemaVersion": "1.0",
  "id": "com.community.slack-workspace",
  "name": "Slack Workspace Velocity",
  "author": {
    "name": "WorkSync",
    "url": "https://apexmouse.tech/community"
  },
  "version": "1.0.0",
  "targetBundleId": "com.tinyspeck.slackmacgap",
  "targetAppName": "Slack",
  "category": "productivity",
  "description": "Workplace communication dial: Quick Switcher, Huddle toggle, Mark as Read, Threads, and Unread jumping.",
  "icon": "number.square.fill",
  "contents": {
    "radialMenu": [
      {
        "label": "Quick Switcher",
        "systemImage": "magnifyingglass",
        "shortcut": "⌘K"
      },
      {
        "label": "Toggle Huddle",
        "systemImage": "headphones",
        "shortcut": "⇧⌘H"
      },
      {
        "label": "Mark All Read",
        "systemImage": "checkmark.circle",
        "shortcut": "⇧Escape"
      },
      {
        "label": "Threads",
        "systemImage": "bubble.left.and.bubble.right",
        "shortcut": "⇧⌘T"
      },
      {
        "label": "Next Unread",
        "systemImage": "arrow.down.circle",
        "shortcut": "⌥⇧Down Arrow"
      },
      {
        "label": "Prev Unread",
        "systemImage": "arrow.up.circle",
        "shortcut": "⌥⇧Up Arrow"
      },
      {
        "label": "New Message",
        "systemImage": "square.and.pencil",
        "shortcut": "⌘N"
      },
      {
        "label": "Activity",
        "systemImage": "bell.fill",
        "shortcut": "⇧⌘M"
      }
    ],
    "buttonMappings": {
      "button3_click": {
        "shortcut": "⌥Up Arrow"
      },
      "button4_click": {
        "shortcut": "⌥Down Arrow"
      }
    }
  },
  "emoji": "💼"
}
